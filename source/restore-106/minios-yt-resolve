        setup = "/usr/local/bin/minios-py311-setup"
    if not os.path.isfile(setup):
        log("tiktok no py311 setup")
        return None
    try:
        py = subprocess.check_output([setup], stderr=open(LOG, "a")).decode().strip()
    except Exception as e:
        log("tiktok py311 setup fail %s" % e)
        return None
    ytd = "/opt/minios/bin/yt-dlp-2026.08.19"
    if not py or not os.path.isfile(py) or not os.path.isfile(ytd):
        log("tiktok missing yt-dlp 2026")
        return None
    env = play_env()
    dest_tmpl = "/tmp/minios-ytplay.%(ext)s"
    clear_play_files()
    write_progress(0, "Downloading video")
    cmd = [
        py, ytd,
        "--no-playlist", "--newline", "--no-check-certificates",
        "-f", "b[ext=mp4][vcodec^=avc]/b[ext=mp4]/b",
        "-o", dest_tmpl,
        "--", url,
    ]
    log("tiktok ytdlp " + " ".join(cmd))
    try:
        p = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            env=env, universal_newlines=True, bufsize=1,
        )
    except Exception as e:
        log("tiktok ytdlp exc %s" % e)
        return None
    deadline = time.time() + 180
    last_pct = -1
    while True:
        if time.time() > deadline:
            try:
                p.kill()
            except Exception:
                pass
            log("tiktok timeout")
            return None
        line = p.stdout.readline() if p.stdout else ""
        if line:
            m = re.search(r"\[download\]\s+([\d.]+)%", line)
            if m:
                pct = int(float(m.group(1)))
                if pct != last_pct:
                    write_progress(pct, "Downloading video")
                    last_pct = pct
            elif "ERROR" in line or "error" in line[:20]:
                log(line.rstrip()[:200])
        elif p.poll() is not None:
            break
        else:
            time.sleep(0.05)
    rc = p.wait()
    log("tiktok ytdlp rc=%s" % rc)
    if rc != 0:
        return None
    write_progress(100, "Video ready")
    return take_download()


def ytdlp_download(vid):
    py = "/usr/local/bin/python3.9"
    if not os.path.isfile(py):
        py = "python3"
    ytd = "/opt/minios/bin/yt-dlp-2025.10.14"
    if not os.path.isfile(ytd):
        ytd = "/opt/minios/bin/yt-dlp-py39"
    if not os.path.isfile(ytd):
        log("no yt-dlp for download fallback")
        return None
    dest_tmpl = "/tmp/minios-ytplay.%(ext)s"
    cmd = [
        py, ytd,
        "--no-playlist", "--no-warnings",
        "--extractor-args", "youtube:player_client=tv,ios,web_safari",
        "-f", "18/best[height<=360][ext=mp4]/best[height<=240]/worst",
        "-o", dest_tmpl,
        "--", "https://www.youtube.com/watch?v=" + vid,
    ]
    log("ytdlp " + " ".join(cmd))
    try:
        rc = subprocess.call(cmd, stdout=open(LOG, "a"), stderr=subprocess.STDOUT)
    except Exception as e:
        log("ytdlp exc %s" % e)
        return None
    log("ytdlp rc=%s" % rc)
    return take_download()


