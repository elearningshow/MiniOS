#!/bin/sh
# ICON-LAUNCH + FLTUBE-AP-01 v1.1
# Usage: minios-run [name] [--tcz pkg.tcz ...] [--] command [args...]
# First click: show "Application is loading. Please wait." and start one copy.
# Later clicks while it is starting or running: same alert, do not start another.
export PATH="/opt/minios/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export DISPLAY="${DISPLAY:-:0}"
export HOME="${HOME:-/home/tc}"

ALERT="Application is loading. Please wait."
case " $* " in
  *" minios-refresh-ram "*|*" refresh-ram "*)
    ALERT="Refresh RAM is loading. Please wait."
    ;;
  *" minios-youtube "*|*" youtube "*)
    ALERT="YouTube is loading. Please wait."
    ;;
  *" minios-tiktok "*|*" tiktok "*)
    ALERT="TikTok is loading. Please wait."
    ;;
  *" minios-music "*|*" music "*|*" minios-mp3 "*)
    ALERT="Music is loading. Please wait."
    ;;
  *" minios-player "*|*" player "*)
    ALERT="MiniOS Media Player is loading. Please wait."
    ;;
esac

if [ "$#" -lt 1 ]; then
  echo "usage: minios-run [name] [--tcz PKG...] [--] COMMAND [args...]"
  exit 1
fi

NAME=""
case "$1" in
  --*|/*|*/*) ;;
  *) NAME="$1"; shift ;;
esac

TCZS=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tcz)
      shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --tcz|--|-*|/*minios-*|*fltube*|*firefox*) break ;;
        esac
        case "$1" in
          *.tcz|*.TCZ) TCZS="$TCZS $1"; shift ;;
          *)
            case "$1" in
              python3*|mplayer*|alsa*|fltube*|ffmpeg*)
                TCZS="$TCZS $1"
                shift
                ;;
              *) break ;;
            esac
            ;;
        esac
      done
      ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if [ "$#" -lt 1 ]; then
  echo "usage: minios-run [name] [--tcz PKG...] [--] COMMAND [args...]"
  exit 1
fi

if [ -z "$NAME" ]; then
  NAME=$(basename "$1" | sed 's/^minios-//')
fi
case "$NAME" in
  refresh-ram|minios-refresh-ram)
    ALERT="Refresh RAM is loading. Please wait."
    ;;
  youtube|fltube|minios-youtube)
    ALERT="YouTube is loading. Please wait."
    ;;
  music|mp3|minios-music|minios-mp3)
    ALERT="Music is loading. Please wait."
    ;;
esac

# Do not lock the session exit / dock restart.
# Create Swap must exec aterm and keep it; wait+pkill closed the window.
case "$NAME" in
  wbar|wbar.sh|exit|exittc|reboot|shutdown)
    exec "$@"
    ;;
  refresh-ram|minios-refresh-ram|"Refresh RAM")
    # Same as Ctrl+Alt+Delete. Do not take a lock — leftover locks ate the click.
    exec "$@"
    ;;
  create-swap|minios-create-swap|Create-Swap|CreateSwap|aterm)
    if command -v popup >/dev/null 2>&1; then
      popup "$ALERT" >/dev/null 2>&1 &
    fi
    exec "$@"
    ;;
esac

LOCKDIR=/tmp/minios-run-${NAME}.lock
START=/tmp/minios-run-${NAME}.start
now=$(date +%s 2>/dev/null || echo 0)

stop_loading() {
  if [ -x /opt/minios/minios-loading ]; then
    /opt/minios/minios-loading stop >/dev/null 2>&1 || true
  elif [ -x /usr/local/bin/minios-loading ]; then
    /usr/local/bin/minios-loading stop >/dev/null 2>&1 || true
  else
    pkill -x xmessage >/dev/null 2>&1 || true
    rm -f /tmp/minios-run-alert.lock /tmp/minios-loading.pid
  fi
}

alert_loading() {
  secs="${1:-15}"
  if [ -x /opt/minios/minios-loading ]; then
    /opt/minios/minios-loading "$secs" "$ALERT"
    return 0
  fi
  if [ -x /usr/local/bin/minios-loading ]; then
    /usr/local/bin/minios-loading "$secs" "$ALERT"
    return 0
  fi
  if [ -f /tmp/minios-run-alert.lock ]; then
    return 0
  fi
  touch /tmp/minios-run-alert.lock
  (
    if command -v xmessage >/dev/null 2>&1; then
      xmessage -center -timeout "$secs" "$ALERT"
    elif command -v aterm >/dev/null 2>&1; then
      aterm +tr +sb -bg black -fg white -T MiniOS -geometry 52x3+200+180 \
        -e sh -c "echo \"$ALERT\"; sleep $secs"
    elif command -v popup >/dev/null 2>&1; then
      popup "$ALERT" &
      pp=$!
      sleep "$secs"
      kill "$pp" 2>/dev/null || true
    fi
    rm -f /tmp/minios-run-alert.lock
  ) >/dev/null 2>&1 &
}

fltube_up() {
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -x fltube >/dev/null 2>&1 && return 0
    pgrep -x FLTube >/dev/null 2>&1 && return 0
    pgrep -f '/usr/local/bin/fltube' >/dev/null 2>&1 && return 0
    pgrep -f '/opt/minios/bin/fltube' >/dev/null 2>&1 && return 0
  fi
  for c in /proc/[0-9]*/comm; do
    [ -r "$c" ] || continue
    n=$(cat "$c" 2>/dev/null)
    case "$n" in fltube|FLTube) return 0 ;; esac
  done
  return 1
}

app_up() {
  case "$NAME" in
    youtube|fltube|minios-youtube)
      fltube_up && return 0
      ;;
    nightly|firefox|minios-firefox)
      pgrep -f '/usr/local/lib/firefox/firefox' >/dev/null 2>&1 && return 0
      pgrep -f 'firefox-bin' >/dev/null 2>&1 && return 0
      ;;
    text-browser|minios-text-browser|links)
      pgrep -x links >/dev/null 2>&1 && return 0
      ;;
    refresh-ram|minios-refresh-ram|"Refresh RAM")
      pgrep -f '/usr/local/bin/minios-refresh-ram' >/dev/null 2>&1 && return 0
      pgrep -f '/opt/minios/minios-refresh-ram' >/dev/null 2>&1 && return 0
      ;;
    create-swap|minios-create-swap|Create-Swap|CreateSwap)
      pgrep -f 'minios-create-swap' >/dev/null 2>&1 && return 0
      ;;
    quick-search|minios-quick-search)
      pgrep -f 'minios-quick-search' >/dev/null 2>&1 && return 0
      ;;
    music|mp3|minios-music|minios-mp3)
      pgrep -x minios-mp3 >/dev/null 2>&1 && return 0
      ;;
    player|minios-player|minios-player-bar)
      pgrep -f '/opt/minios/minios-player-bar' >/dev/null 2>&1 && return 0
      pgrep -f '/usr/local/bin/minios-player-bar' >/dev/null 2>&1 && return 0
      ;;
  esac
  return 1
}

lock_holder_alive() {
  [ -d "$LOCKDIR" ] || return 1
  lp=$(cat "$LOCKDIR/pid" 2>/dev/null)
  [ -n "$lp" ] || return 1
  kill -0 "$lp" 2>/dev/null
}

# A closed app must be startable again in the same session.
# v0.2.50: leftover lock / 8-second recent_start / "already running"
# showed "YouTube is loading" and never launched.
# v0.2.92: CAD Refresh left lock directories and a waiting minios-run.
# Dock clicks then exited 0. Steal a stale lock when the app is gone.
if app_up; then
  stop_loading
  exit 0
fi
if [ -d "$LOCKDIR" ]; then
  if lock_holder_alive; then
    started=$(cat "$START" 2>/dev/null || echo 0)
    age=$((now - started))
    if [ "$started" != 0 ] && [ "$age" -ge 0 ] && [ "$age" -lt 20 ]; then
      exit 0
    fi
  fi
  rm -rf "$LOCKDIR"
  rm -f "$START"
fi

if ! mkdir "$LOCKDIR" 2>/dev/null; then
  if app_up; then
    stop_loading
    exit 0
  fi
  if ! lock_holder_alive; then
    rm -rf "$LOCKDIR"
    mkdir "$LOCKDIR" || exit 1
  else
    exit 0
  fi
fi
echo $$ >"$LOCKDIR/pid"
echo "$now" >"$START"
# Refresh RAM shows its own status window. The xmessage alert is killed
# by reclaim and looks like the button did nothing.
case "$NAME" in
  refresh-ram|minios-refresh-ram|"Refresh RAM")
    ;;
  *)
    alert_loading 30
    ;;
esac

for t in $TCZS; do
  if [ -x /opt/minios/minios-load-tcz ]; then
    /opt/minios/minios-load-tcz "$t" || true
  fi
done

"$@" &
APP=$!

# YouTube: only report fail if the launcher died and FLTube is not running.
# v0.2.31 showed "YouTube did not open" after 15s while FLTube was already open
# (sound-up blocked start past the deadline).
case "$NAME" in
  youtube|fltube|minios-youtube)
    n=0
    while [ "$n" -lt 40 ]; do
      if fltube_up; then
        stop_loading
        break
      fi
      if ! kill -0 "$APP" 2>/dev/null; then
        break
      fi
      sleep 1
      n=$((n + 1))
    done
    if ! fltube_up && ! kill -0 "$APP" 2>/dev/null; then
      echo "YouTube did not open." >>/tmp/minios-youtube.log
      if [ -x /opt/minios/minios-youtube-fail ]; then
        /opt/minios/minios-youtube-fail >/dev/null 2>&1 &
      elif [ -x /usr/local/bin/minios-youtube-fail ]; then
        /usr/local/bin/minios-youtube-fail >/dev/null 2>&1 &
      fi
    fi
    ;;
esac

wait "$APP"
status=$?

case "$NAME" in
  youtube|fltube|minios-youtube)
    if [ -x /opt/minios/minios-log-usb ]; then
      sudo -n /opt/minios/minios-log-usb youtube-done >/dev/null 2>&1 || \
        /opt/minios/minios-log-usb youtube-done >/dev/null 2>&1 || true
    fi
    ;;
esac

# Only reap Firefox/FLTube children. Never pkill aterm (Create Swap).
case "$NAME" in
  nightly|firefox|minios-firefox|youtube|fltube|minios-youtube)
    if [ -n "$APP" ]; then
      pkill -P "$APP" 2>/dev/null || true
    fi
    ;;
esac
stop_loading
rm -rf "$LOCKDIR"
rm -f "$START"

# Gate D: after the wrapped child exits, reclaim. Never hook Create Swap.
# CAD Refresh already runs reclaim full. Do not start a second one.
case "$NAME" in
  create-swap|minios-create-swap|Create-Swap|CreateSwap|aterm)
    ;;
  *)
    if [ ! -f /tmp/minios-refreshing ]; then
      if [ -x /usr/local/bin/minios-reclaim ]; then
        sudo -n /usr/local/bin/minios-reclaim auto >>/tmp/minios-reclaim.log 2>&1 || \
          /usr/local/bin/minios-reclaim auto >>/tmp/minios-reclaim.log 2>&1 || true
      elif [ -x /opt/minios/minios-reclaim ]; then
        sudo -n /opt/minios/minios-reclaim auto >>/tmp/minios-reclaim.log 2>&1 || true
      fi
    fi
    ;;
esac
exit "$status"
