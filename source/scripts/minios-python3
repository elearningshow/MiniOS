#!/bin/sh
# BAKE-AP-01 v1.8: python3.9 is on onboot. Do not tce-load from this wrapper.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
if [ -x /usr/local/bin/python3.9 ]; then
  exec /usr/local/bin/python3.9 "$@"
fi
if [ -x /tmp/tcloop/python3.9/usr/local/bin/python3.9 ]; then
  exec /tmp/tcloop/python3.9/usr/local/bin/python3.9 "$@"
fi
echo "python3: python3.9 is not on PATH (expected onboot)" >&2
exit 127
