#!/usr/bin/env python3
# Play only. Search stays on yt-dlp 2025.10.14 + python3.9.
# Print ONE progressive HTTP URL (or a local file). SABR killed yt-dlp -g.
# Prefer Piped / Invidious *proxy* URLs so the Gateway IP is not locked out.
from __future__ import print_function

