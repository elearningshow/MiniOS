#!/bin/sh
# MiniOS Streaming search. This does not call YouTube or TikTok.
# A word asks Radio Browser for a short list of plain MP3 or AAC stations.
# The Xiph directory file is empty, so it is not used.
export PATH="/opt/minios/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Q="${1:-}"
LOG=/tmp/minios-st-search.log
RAW=/tmp/minios-st-raw.json
UA="MiniOS/0.2.248"
{
  echo "===== streaming-search $(date -u) ====="
  echo "q=$Q"
} >>"$LOG"
rm -f "$RAW"
if [ -z "$Q" ]; then
  printf 'STATUS\tType a word, or paste a station address.\n'
  exit 0
fi
case "$Q" in
  http://*|https://*)
    printf 'STATUS\tPlaying the address you pasted.\n'
    printf 'Station\t%s\tURL\t\n' "$Q"
    exit 0
    ;;
esac
PY=""
if [ -x /usr/local/bin/python3.9 ]; then
  PY=/usr/local/bin/python3.9
elif command -v python3.9 >/dev/null 2>&1; then
  PY=$(command -v python3.9)
elif command -v python3 >/dev/null 2>&1; then
  PY=$(command -v python3)
fi
if [ -z "$PY" ]; then
  echo "no python" >>"$LOG"
  printf 'STATUS\tSearch needs Python, which is not running.\n'
  exit 1
fi
LANGW=""
if [ -r /proc/cmdline ]; then
  LANGW=$(tr ' ' '\n' </proc/cmdline | sed -n 's/^lang=//p' | head -n 1)
fi
if [ -z "$LANGW" ]; then
  LANGW=${LANG:-en}
fi
case "$LANGW" in
  C|POSIX|en|en_*|en.*) LANGW=english ;;
  es|es_*) LANGW=spanish ;;
  fr|fr_*) LANGW=french ;;
  de|de_*) LANGW=german ;;
  pt|pt_*) LANGW=portuguese ;;
  *) LANGW="" ;;
esac
echo "search lang=$LANGW" >>"$LOG"
ENC=$("$PY" -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$Q" 2>>"$LOG" || true)
if [ -z "$ENC" ]; then
  printf 'STATUS\tCould not read that word.\n'
  exit 1
fi
QS="name=${ENC}&limit=40&hidebroken=true&order=clickcount&reverse=true"
if [ -n "$LANGW" ]; then
  QS="${QS}&language=${LANGW}"
fi
got=0
for host in de1.api.radio-browser.info de2.api.radio-browser.info; do
  url="https://${host}/json/stations/search?${QS}"
  echo "get $host" >>"$LOG"
  rm -f "$RAW"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --connect-timeout 5 --max-time 12 -A "$UA" -o "$RAW" "$url" >>"$LOG" 2>&1 || true
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$RAW" --user-agent="$UA" --timeout=12 "$url" >>"$LOG" 2>&1 || true
  fi
  if [ -s "$RAW" ]; then
    got=1
    echo "host=$host bytes=$(wc -c <"$RAW" | tr -dc '0-9')" >>"$LOG"
    break
  fi
done
if [ "$got" -eq 1 ]; then
"$PY" - "$RAW" <<'PY' 2>>"$LOG"
import json, sys
path = sys.argv[1]
try:
    rows = json.loads(open(path, "r", errors="replace").read())
except Exception as exc:
    sys.stderr.write("json %s\n" % exc)
    sys.exit(1)
if not isinstance(rows, list):
    sys.stderr.write("json not a list\n")
    sys.exit(1)
keep = []
seen = set()
ok_codec = {"MP3", "AAC", "AAC+"}
for row in rows:
    if not isinstance(row, dict):
        continue
    if row.get("hls") not in (0, "0", False, None):
        continue
    if row.get("lastcheckok") in (0, "0", False):
        continue
    codec = str(row.get("codec") or "").upper()
    if codec not in ok_codec:
        continue
    url = str(row.get("url_resolved") or row.get("url") or "")
    low = url.lower()
    if not (low.startswith("http://") or low.startswith("https://")):
        continue
    if ".m3u8" in low or ".isml" in low or "/hls/" in low:
        continue
    if url in seen:
        continue
    seen.add(url)
    name = str(row.get("name") or "Station").replace("\t", " ").replace("\n", " ").strip()
    if not name:
        name = "Station"
    if len(name) > 70:
        name = name[:67] + "..."
    rate = str(row.get("bitrate") or "").strip()
    keep.append((name, url, codec, rate))
    if len(keep) >= 6:
        break
sys.stderr.write("kept %d of %d\n" % (len(keep), len(rows)))
open("/tmp/minios-st-radio.txt", "w").write("".join(
    "%s\t%s\t%s\t%s\n" % (name, url, codec, rate) for name, url, codec, rate in keep))
PY
  rc=$?
  rm -f "$RAW"
  if [ "$rc" -ne 0 ]; then
    echo "radio parse failed" >>"$LOG"
    : >/tmp/minios-st-radio.txt
  fi
else
  echo "no radio directory" >>"$LOG"
  : >/tmp/minios-st-radio.txt
fi

# Picture channels come from more than one free list.
# Free-TV is first. The next list is used when six picture rows are not ready yet.
# Do not open each channel during the search.
st_video_count() {
  if [ -s /tmp/minios-st-freetv.txt ]; then
    wc -l < /tmp/minios-st-freetv.txt | tr -dc '0-9'
  else
    echo 0
  fi
}

st_pick_video() {
  st_mode=$1
  "$PY" - "$st_list" "$Q" "$LANGW" "$st_mode" <<'PY' 2>>"$LOG"
import os, re, sys
path, query, lang, mode = sys.argv[1], sys.argv[2].lower(), sys.argv[3], sys.argv[4]
outpath = "/tmp/minios-st-freetv.txt"
scorepath = "/tmp/minios-st-scores"
known = {}
if os.path.isfile(scorepath):
    for oldscore in open(scorepath, "r", errors="replace"):
        bits = oldscore.rstrip("\n").split("\t")
        if len(bits) == 2 and bits[1].isdigit():
            known[bits[0]] = int(bits[1])
prefer = set()
if lang == "english":
    prefer = {"usa", "uk", "us", "united states", "united kingdom", "canada",
              "australia", "ireland", "new zealand", "news", "international", "english"}
hits = []
seen = set()
if os.path.isfile(outpath):
    for old in open(outpath, "r", errors="replace"):
        parts = old.rstrip("\n").split("\t")
        if len(parts) < 2 or not parts[1].startswith("http"):
            continue
        if parts[1] in seen:
            continue
        seen.add(parts[1])
        label = parts[3] if len(parts) > 3 else "TV"
        hits.append((known.get(parts[1], 2), parts[0], parts[1], label))
text = open(path, "r", errors="replace").read().splitlines()
extra = []
extra_seen = set()
i = 0
while i < len(text):
    line = text[i].strip()
    if not line.startswith("#EXTINF"):
        i += 1
        continue
    name = line.rsplit(",", 1)[-1].strip().replace("\t", " ")
    group = ""
    mark = 'group-title="'
    at = line.find(mark)
    if at >= 0:
        group = line[at + len(mark):line.find('"', at + len(mark))]
    i += 1
    while i < len(text) and (not text[i].strip() or text[i].strip().startswith("#")):
        i += 1
    url = text[i].strip() if i < len(text) else ""
    if i < len(text):
        i += 1
    low = url.lower()
    g = group.lower()
    if g.startswith("vod") or "vod" in g:
        continue
    if ("youtube.com" in low or "youtu.be" in low or "twitch.tv" in low
            or "ythls." in low or "googlevideo.com" in low):
        continue
    if ".mp4" in low or "/vod/" in low:
        continue
    if not (low.startswith("http://") or low.startswith("https://")):
        continue
    if url in seen or url in extra_seen:
        continue
    blob = (name + " " + group).lower()
    words = [w for w in re.split(r"[^a-z0-9]+", query) if len(w) > 1]
    if not words:
        words = [query] if query else []
    whole = (not words) or all(
        re.search(r"(^|[^a-z0-9])%s([^a-z0-9]|$)" % re.escape(w), blob) for w in words)
    part = bool(words) and all(len(w) >= 4 for w in words) and all(w in blob for w in words)
    en = name[:67] + "..." if len(name) > 70 else name
    label = group[:24] if group else "TV"
    preferred = g in prefer or "news" in g
    if whole or (part and preferred):
        seen.add(url)
        score = 5 if whole else 1
        if query and query in name.lower():
            score += 1
        if preferred:
            score += 2
        hits.append((score, en, url, label))
        continue
    if len(extra) < 12 and preferred:
        extra_seen.add(url)
        extra.append((0, en, url, label))
hits.sort(key=lambda row: (-row[0], row[1].lower()))
if mode == "fill" and len(hits) < 4:
    have = set(row[2] for row in hits)
    for row in extra:
        if row[2] in have:
            continue
        hits.append(row)
        have.add(row[2])
        if len(hits) >= 6:
            break
hits = hits[:6]
strong = sum(1 for row in hits if row[0] >= 5)
sys.stderr.write("video kept %d strong %d\n" % (len(hits), strong))
out = open(outpath, "w")
saved = open(scorepath, "w")
for score, name, url, label in hits:
    out.write("%s\t%s\tTV\t%s\n" % (name, url, label))
    saved.write("%s\t%d\n" % (url, score))
out.close()
saved.close()
open("/tmp/minios-st-strong", "w").write("%d\n" % strong)
PY
}

st_fetch_video() {
  st_name=$1
  st_url=$2
  st_mode=$3
  st_now=$(date +%s)
  if [ "$st_now" -ge "$st_deadline" ]; then
    echo "video source $st_name skipped time" >>"$LOG"
    return 0
  fi
  st_strong=0
  if [ -s /tmp/minios-st-strong ]; then
    st_strong=$(tr -dc '0-9' < /tmp/minios-st-strong)
  fi
  if [ "${st_strong:-0}" -ge 6 ] && [ "$st_mode" != "fill" ]; then
    echo "video source $st_name skipped full" >>"$LOG"
    return 0
  fi
  st_left=$((st_deadline - st_now))
  if [ "$st_left" -gt 12 ]; then
    st_left=12
  fi
  if [ "$st_left" -lt 4 ]; then
    echo "video source $st_name skipped time" >>"$LOG"
    return 0
  fi
  echo "video source $st_name" >>"$LOG"
  st_list=/tmp/minios-st-tv.m3u8
  rm -f "$st_list"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --connect-timeout 5 --max-time "$st_left" -A "$UA" -o "$st_list" \
      "$st_url" >>"$LOG" 2>&1 || true
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$st_list" --user-agent="$UA" --timeout="$st_left" \
      "$st_url" >>"$LOG" 2>&1 || true
  fi
  if [ ! -s "$st_list" ]; then
    echo "video source $st_name empty" >>"$LOG"
    rm -f "$st_list"
    return 0
  fi
  echo "video source $st_name bytes=$(wc -c <"$st_list" | tr -dc '0-9')" >>"$LOG"
  st_sources=$((st_sources + 1))
  st_pick_video "$st_mode"
  rm -f "$st_list"
}

st_video_lists() {
  st_sources=0
  st_deadline=$(( $(date +%s) + 28 ))
  : >/tmp/minios-st-freetv.txt
  : >/tmp/minios-st-strong
  rm -f /tmp/minios-st-scores
  st_fetch_video "free-tv" \
    "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8" match
  if [ ! -s /tmp/minios-st-freetv.txt ]; then
    st_fetch_video "free-tv-usa" \
      "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_usa.m3u8" match
    st_fetch_video "free-tv-news" \
      "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_zz_news_en.m3u8" match
  fi
  st_fetch_video "iptv-org-news" \
    "https://iptv-org.github.io/iptv/categories/news.m3u" match
  st_fetch_video "pluto-us" \
    "https://raw.githubusercontent.com/BuddyChewChew/app-m3u-generator/main/playlists/plutotv_us.m3u" match
  st_have=$(st_video_count)
  if [ "${st_have:-0}" -lt 4 ]; then
    st_fetch_video "free-tv-news" \
      "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_zz_news_en.m3u8" fill
  fi
  echo "video sources=$st_sources kept=$(st_video_count)" >>"$LOG"
}
st_video_lists
radio_n=0
tv_n=0
if [ -s /tmp/minios-st-radio.txt ]; then
  radio_n=$(wc -l </tmp/minios-st-radio.txt | tr -dc '0-9')
fi
if [ -s /tmp/minios-st-freetv.txt ]; then
  tv_n=$(wc -l </tmp/minios-st-freetv.txt | tr -dc '0-9')
fi
echo "radio=$radio_n tv=$tv_n" >>"$LOG"
if [ "${radio_n:-0}" -lt 1 ] && [ "${tv_n:-0}" -lt 1 ]; then
  printf 'STATUS\tNo station matched that word. Try another word, or paste an address.\n'
  rm -f /tmp/minios-st-radio.txt /tmp/minios-st-freetv.txt /tmp/minios-st-scores /tmp/minios-st-strong
  exit 1
fi
if [ "${tv_n:-0}" -gt 0 ] && [ "${st_sources:-0}" -gt 1 ]; then
  printf 'STATUS\tEach row is marked Video or Audio. Video stations are included. More than one video list was searched.\n'
elif [ "${tv_n:-0}" -gt 0 ]; then
  printf 'STATUS\tEach row is marked Video or Audio. Video stations are included.\n'
else
  printf 'STATUS\tEach row is marked Video or Audio.\n'
fi
if [ -s /tmp/minios-st-radio.txt ]; then
  cat /tmp/minios-st-radio.txt
fi
if [ -s /tmp/minios-st-freetv.txt ]; then
  cat /tmp/minios-st-freetv.txt
fi
rm -f /tmp/minios-st-radio.txt /tmp/minios-st-freetv.txt /tmp/minios-st-scores /tmp/minios-st-strong
exit 0
