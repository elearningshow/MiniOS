#!/bin/sh
# TikTok close only. The search window is already gone.
# Do not swap zram off, do not stop AI Chat, and do not stop YouTube.
export PATH="/opt/minios/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
LOG=/tmp/minios-tt-release.log
echo "===== tt-release $(date -u) =====" >>"$LOG"

# The recorded pid is the TikTok player. Kill it only when that pid is mplayer.
tt_release_one_mplayer() {
  mp=$(cat /tmp/minios-tt-mp.pid 2>/dev/null || true)
  case "$mp" in
    ''|*[!0-9]*)
      echo "tt-release no recorded player" >>"$LOG"
      return 0
      ;;
  esac
  if [ "$(cat /proc/$mp/comm 2>/dev/null)" = mplayer ]; then
    kill -9 "$mp" 2>/dev/null || true
    echo "tt-release killed mplayer $mp" >>"$LOG"
  else
    echo "tt-release pid $mp is not mplayer" >>"$LOG"
  fi
}

tt_release_temps() {
  rm -rf /tmp/minios-tt-thumbs /tmp/minios-tt-dl
  rm -f /tmp/minios-tt-search.html /tmp/minios-tt-raw.txt /tmp/minios-tt-last.txt \
        /tmp/minios-tt-rows.txt /tmp/minios-tt-cookies /tmp/minios-tt-reason.txt \
        /tmp/minios-tt-chunk.html /tmp/minios-tt-oe.json /tmp/minios-tt-tw.json \
        /tmp/minios-tiktok.ready /tmp/minios-tt-play.pid /tmp/minios-tt-thumbs.pid \
        /tmp/minios-yt-tiktok /tmp/minios-tt-mp.cmd /tmp/minios-tt-mp.pid \
        /tmp/minios-tt-mp.out /tmp/minios-tt-mp.done /tmp/minios-tt-mp.fail \
        /tmp/minios-tt-mp.geom /tmp/minios-tt-mp.quit /tmp/minios-tt-player-bar.pid \
        /tmp/minios-tt-playlist /tmp/minios-ttplay.mp4 /tmp/minios-tt-dl.progress \
        /tmp/minios-tt-picture.up /tmp/minios-tt-flag /tmp/minios-tt-player-mode
}

# Quit file, recorded player, TikTok programs, and TikTok temps.
# Packages stay mounted. Caches stay. AI Chat keeps python3.9.
tt_release_close() {
  echo 1 >/tmp/minios-tt-mp.quit 2>/dev/null || true
  tt_release_one_mplayer
  pkill -f /opt/minios/minios-tiktok-search 2>/dev/null || true
  pkill -f /usr/local/bin/minios-tiktok-search 2>/dev/null || true
  pkill -f /opt/minios/minios-tiktok-thumbs 2>/dev/null || true
  pkill -f /usr/local/bin/minios-tiktok-thumbs 2>/dev/null || true
  pkill -f /opt/minios/minios-tiktok-play 2>/dev/null || true
  pkill -f /usr/local/bin/minios-tiktok-play 2>/dev/null || true
  pkill -f /opt/minios/minios-tt-player-bar 2>/dev/null || true
  pkill -f /usr/local/bin/minios-tt-player-bar 2>/dev/null || true
  pkill -f /opt/minios/minios-tt-mplayer 2>/dev/null || true
  pkill -f /usr/local/bin/minios-tt-mplayer 2>/dev/null || true
  tt_release_temps
  # Do not unmount packages and do not drop caches. Unmounting held the
  # close, and dropping caches made the next AI Chat miss python3.9.
  echo "tt-release leave python and caches" >>"$LOG"
  echo "tt-release done" >>"$LOG"
  exit 0
}

tt_release_close
